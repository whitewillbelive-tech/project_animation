          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"
        },
        "job_state": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "interrupted"
          ]
        },
        "used_inputs": {
          "type": "object",
          "properties": {
            "source_revision": {
              "type": "integer",
