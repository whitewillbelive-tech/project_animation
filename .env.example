# 서버 설정 예시. 실제 비밀값은 저장소에 넣지 마세요.
ANIMATION_DATA_DIR=./data
# HTTPS 리버스 프록시의 실제 비공개 서비스 출처를 지정합니다.
# HTTPS 출처에서는 Secure 쿠키를 사용합니다. 로컬 개발은 생략합니다.
# ANIMATION_PUBLIC_ORIGIN=https://animation.example.com
# 선택: 초기 소유자 생성 명령에서만 사용하는 비밀번호.
# 가능하면 환경 변수 대신 대화형 getpass 입력을 사용하세요.
# ANIMATION_OWNER_PASSWORD=
